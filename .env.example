TSETMC_USERNAME=your_username
TSETMC_PASSWORD=your_password
TSETMC_BASE_URL=https://api.tsetmc.com
# Flow for derivatives/options market (ATI = 3)
TSETMC_FLOW=3
# API timeouts in seconds
TSETMC_LOGIN_TIMEOUT=10
TSETMC_REQUEST_TIMEOUT=60
# 0 = bypass system proxy for TSETMC. Set to 1 only if your proxy can reach TSETMC.
TSETMC_TRUST_ENV_PROXY=0
# Parallel workers for public CDN client type history fallback
TSETMC_PUBLIC_CLIENT_TYPE_WORKERS=16
# SQLite database path
DATABASE_PATH=data/tsetmc_options.db
# CSV export directory
DATA_DIR=data/exports
# Web UI
WEB_PORT=8080
WEB_HOST=0.0.0.0
WEB_OPEN_BROWSER=1
